model User {
    id            String        @id @default(uuid())
    name          String        @db.VarChar(50)
    email         String        @unique @db.VarChar(100)
    password      String        @db.VarChar(50)
    role          Rele          @default(CUSTOMER)
    createdAt     DateTime      @default(now())
    updatedAt     DateTime      @updatedAt

    @@map("users")
}